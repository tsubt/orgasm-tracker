// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Necessary for Next auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  username      String?   @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  joinedAt  DateTime @default(now())
  lastSeen  DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  bio String? @db.Text

  publicOrgasms Boolean @default(false)
  publicProfile Boolean @default(false)

  trackChastityStatus Boolean @default(false)

  defaultProfileChart String?

  firstDayOfWeek Int @default(1) // 0 = Sunday, 1 = Monday, ..., 6 = Saturday

  timezone String?

  hideLocktoberBoard Boolean @default(false)

  accounts         Account[]
  sessions         Session[]
  orgasms          Orgasm[]
  dashboardCharts  DashboardChart[]
  chastitySessions ChastitySession[]
  locktoberChallenges LocktoberChallenge[]
  locktoberLikes      LocktoberLike[]
  locktoberComments   LocktoberComment[]

  // Follow relationships
  followers        Follow[] @relation("UserFollowers")
  following        Follow[] @relation("UserFollowing")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum OrgasmType {
  FULL
  RUINED
  HANDSFREE
  ANAL
}

enum SexType {
  SOLO
  VIRTUAL
  PHYSICAL
}

model Orgasm {
  id        String    @id @default(cuid())
  timestamp DateTime?
  note      String?   @db.Text

  type OrgasmType @default(FULL)
  sex  SexType    @default(SOLO)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  locktoberClaim LocktoberCumDay?

  @@index([userId, timestamp])
}

model DashboardChart {
  id            String @id @default(cuid())
  userId        String
  chartName     String
  chartPosition Int
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chartPosition])
  @@index([userId])
}

model ChastitySession {
  id        String    @id @default(cuid())
  startTime DateTime
  endTime   DateTime?
  note      String?   @db.Text

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, startTime])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

enum LocktoberVisibility {
  PRIVATE
  LINK
  PUBLIC
}

enum LocktoberCumDayStatus {
  SCHEDULED
  LOCKED
  CLAIMED
  SKIPPED
}

enum LocktoberTaskKind {
  REWARD
  PENALTY
}

enum LocktoberTaskMode {
  FIXED
  PER_MINUTE
  ENTER_AMOUNT
  TIME_LOCKED
}

enum LocktoberRateUnit {
  HOUR
  DAY
  SECOND
  MINUTE
}

enum LocktoberCadence {
  DAILY
  WEEKLY
  MONTHLY
}

model LocktoberChallenge {
  id             String               @id @default(cuid())
  userId         String
  year           Int
  timezone       String
  allowedOrgasms Int
  visibility     LocktoberVisibility  @default(PRIVATE)
  shareSlug      String               @unique @default(cuid())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tiers       LocktoberRewardTier[]
  cumDays     LocktoberCumDay[]
  tasks       LocktoberTask[]
  completions LocktoberCompletion[]
  likes       LocktoberLike[]
  comments    LocktoberComment[]
  card        LocktoberCard?

  @@unique([userId, year])
  @@index([userId])
  @@index([visibility, year])
}

/** Precomputed public-card stats. The social image reads this row and does not rescore. */
model LocktoberCard {
  challengeId   String
  year          Int
  display       String
  username      String?
  shareSlug     String              @unique
  visibility    LocktoberVisibility
  lockedMinutes Int
  points        Int
  daysLeft      Int?
  /** Reward targets on the minimal bar: `{ label, points }[]`, lowest first. */
  targets       Json                @default("[]")
  refreshedAt   DateTime            @default(now())

  challenge LocktoberChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@id([challengeId])
  @@index([username, year])
}

model LocktoberRewardTier {
  id            String      @id @default(cuid())
  challengeId   String
  label         String
  points        Int
  orgasmType    OrgasmType?
  expectsLocked Boolean     @default(false)
  sortOrder     Int

  challenge LocktoberChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

model LocktoberCumDay {
  id                String                @id @default(cuid())
  challengeId       String
  date              DateTime              @db.Date
  status            LocktoberCumDayStatus @default(SCHEDULED)
  pointsAtLock      Int?
  tierSnapshot      Json?
  claimedTierLabel  String?
  orgasmId          String?               @unique
  claimedAt         DateTime?

  challenge LocktoberChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  orgasm    Orgasm?            @relation(fields: [orgasmId], references: [id], onDelete: SetNull)

  @@unique([challengeId, date])
  @@index([challengeId])
}

model LocktoberTask {
  id             String             @id @default(cuid())
  challengeId    String
  title          String
  description    String?            @db.Text
  kind           LocktoberTaskKind
  points         Int?
  mode           LocktoberTaskMode
  cadence        LocktoberCadence
  maxCompletions Int?
  maxPoints      Int?
  noteRequired   Boolean            @default(false)
  rateEvery      Int?
  rateUnit       LocktoberRateUnit?
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())

  challenge   LocktoberChallenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  completions LocktoberCompletion[]

  @@index([challengeId])
}

model LocktoberCompletion {
  id            String   @id @default(cuid())
  challengeId   String
  taskId        String?
  completedAt   DateTime @default(now())
  minutes       Int?
  note          String?  @db.Text
  pointsAwarded Int
  snapshot      Json

  challenge LocktoberChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  task      LocktoberTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([challengeId, completedAt])
  @@index([taskId])
}

model LocktoberLike {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  createdAt   DateTime @default(now())

  challenge LocktoberChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([userId])
}

model LocktoberComment {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  body        String   @db.VarChar(500)
  createdAt   DateTime @default(now())

  challenge LocktoberChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeId, createdAt])
  @@index([userId])
}
